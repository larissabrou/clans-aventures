# Copier en .env.local (jamais commité) et compléter.
# Sur Coolify : saisir ces variables dans l'onglet « Environment Variables » de l'application.

# Adresse publique du site : liens WhatsApp et retours Wave. En local, laissez-la vide (Wave refuse localhost).
NEXT_PUBLIC_SITE_URL=https://clans-aventures.com

# Phase de test : montant réellement débité en FCFA, à la place du prix réglé dans l'admin
# (Réglages). Le site affiche toujours le prix de l'admin. Au lancement : supprimer cette variable.
MONTANT_DEBITE=500

# Emails des membres qui accèdent à /admin (séparés par des virgules)
ADMIN_EMAILS=

# Base PostgreSQL. Sur Coolify : « Postgres URL (internal) » de la ressource PostgreSQL.
# En local : postgresql://postgres:MOT_DE_PASSE@localhost:5432/clans_aventures
DATABASE_URL=

# Secret qui signe les codes de connexion (obligatoire en production).
# Générer une valeur : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Paiement Mobile Money : Payment Gateway (AggregPay), la passerelle de Czotick.
# Clé API et secret du webhook : fiche partenaire « Clans aventures » sur https://payment.czotick.com/admin/partners
# Webhook à déclarer sur la fiche : https://clans-aventures.com/webhooks/payment
PAYMENT_GATEWAY_URL=https://payment.czotick.com
PAYMENT_GATEWAY_API_KEY=
# Obligatoire en production : sans lui, les webhooks sont refusés.
PAYMENT_GATEWAY_WEBHOOK_SECRET=
PAYMENT_GATEWAY_DEFAULT_CURRENCY=XOF
PAYMENT_GATEWAY_MIN_AMOUNT=500

# Emails (codes de connexion et messages aux membres), par SMTP.
# Boîte LWS : utiliser le nom du serveur LWS (mail16.lwspanel.com), PAS mail.clans-aventures.com :
# le certificat TLS de LWS est au nom de *.lwspanel.com, sinon la connexion est refusée.
# Sans SMTP_HOST, en local, les emails s'affichent dans la console du serveur.
SMTP_HOST=mail16.lwspanel.com
SMTP_PORT=465
SMTP_USER=noreply@clans-aventures.com
SMTP_PASSWORD=
SMTP_FROM=CLANS aventures <noreply@clans-aventures.com>

# WhatsApp Business Cloud API (Meta) : pas encore utilisé (les messages partent par email).
# Gardé pour plus tard ; voir src/lib/whatsapp.ts.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
